#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8087

struct CalcRequest {
    double num1;
    double num2;
    char op;
};

struct CalcResponse {
    double result;
    int valid;
    char error_msg[50];
};

int main() {
    int sockfd;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);
    struct CalcRequest req;
    struct CalcResponse res;
    
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);
    
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);
    
    bind(sockfd, (struct sockaddr*)&server_addr, sizeof(server_addr));
    printf("UDP Calculation Server listening on port %d...\n", PORT);
    
    while (1) {
        recvfrom(sockfd, &req, sizeof(req), 0, (struct sockaddr*)&client_addr, &addr_len);
        
        res.valid = 1;
        res.result = 0.0;
        res.error_msg[0] = '\0';
        
        if (req.op == '+') {
            res.result = req.num1 + req.num2;
        } 
        else if (req.op == '-') {
            res.result = req.num1 - req.num2;
        } 
        else if (req.op == '*') {
            res.result = req.num1 * req.num2;
        } 
        else if (req.op == '/') {
            if (req.num2 == 0.0) {
                res.valid = 0;
                strcpy(res.error_msg, "Division by zero invalid!");
            } else {
                res.result = req.num1 / req.num2;
            }
        } 
        else {
            res.valid = 0;
            strcpy(res.error_msg, "Unknown math operator flag!");
        }
        
        sendto(sockfd, &res, sizeof(res), 0, (struct sockaddr*)&client_addr, addr_len);
    }
    
    close(sockfd);
    return 0;
}
