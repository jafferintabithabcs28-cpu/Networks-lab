#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <arpa/inet.h>
int add(int a,int b)
{
   return a+b;
}
int mul(int a, int b)
{
   return a*b;
}
int sub(int a,int b)
{
   return a-b;
}
int main(int argc, char *argv[])
{
    int sockfd;
    struct sockaddr_in server, client;
    socklen_t len = sizeof(client);
    char procedure[20];
    int a, b, result;
    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);
    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(atoi(argv[1]));
    bind(sockfd, (struct sockaddr *)&server, sizeof(server));
    printf("UDP RPC Server started on port %s\n", argv[1]);
    while (1)
    {
        recvfrom(sockfd, procedure, sizeof(procedure), 0,
                 (struct sockaddr *)&client, &len);
        recvfrom(sockfd, &a, sizeof(a), 0,
                 (struct sockaddr *)&client, &len);
        recvfrom(sockfd, &b, sizeof(b), 0,
                 (struct sockaddr *)&client, &len);
        a = ntohl(a);
        b = ntohl(b);
        if (strcmp(procedure, "add") == 0)
            result = add(a,b);
        else if (strcmp(procedure, "sub") == 0)
            result = sub(a,b);
        else if (strcmp(procedure, "mul") == 0)
            result = mul(a,b);
        else
            result = 0;
        result = htonl(result);
        sendto(sockfd, &result, sizeof(result), 0,
               (struct sockaddr *)&client, len);
        printf("Procedure executed successfully\n");
    }
    close(sockfd);
    return 0;
}
