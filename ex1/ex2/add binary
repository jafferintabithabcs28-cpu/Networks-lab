char* addBinary(char* a, char* b) {
    int len_a = strlen(a);
    int len_b = strlen(b);
    int max_len = (len_a > len_b ? len_a : len_b) + 1;
    char* res = (char*)malloc((max_len + 1) * sizeof(char));
    if (res == NULL) return NULL; 
    res[max_len] = '\0';
    int i = len_a - 1;
    int j = len_b - 1;
    int k = max_len - 1; 
    int carry = 0;
    while (i >= 0 || j >= 0 || carry) {
        int total = carry;
        
        if (i >= 0) {
            total += a[i] - '0'; 
            i--;
        }
        if (j >= 0) {
            total += b[j] - '0'; 
            j--;
        }
        
        res[k] = (total % 2) + '0'; 
        k--;
        carry = total / 2;
    }
    if (k >= 0) {
        memmove(res, &res[k + 1], max_len - k);
    }

    return res;
}
