#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8080

int main() {
    int sockfd;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);
    
    int expected_frame = 1;
    int total_frames;
    int error_frame;
    int error_triggered = 0;
    
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sockfd < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }
    
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);
    
    if (bind(sockfd, (struct sockaddr*)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        exit(EXIT_FAILURE);
    }
    
    printf("Waiting for Sender initialization details...\n");
    recvfrom(sockfd, &total_frames, sizeof(total_frames), 0, (struct sockaddr*)&client_addr, &addr_len);
    
    printf("Enter a frame number to simulate drop/loss (1 to %d, or 0 for none): ", total_frames);
    scanf("%d", &error_frame);
    
    printf("\nReady to receive frames...\n");
    
    while (expected_frame <= total_frames) {
        int frame_id;
        recvfrom(sockfd, &frame_id, sizeof(frame_id), 0, (struct sockaddr*)&client_addr, &addr_len);
        
        if (frame_id == error_frame && !error_triggered) {
            error_triggered = 1;
            printf("[Receiver] !!! Frame %d was dropped/lost intentionally !!!\n", frame_id);
            continue;
        }
        
        if (frame_id == expected_frame) {
            printf("[Receiver] Frame %d received. Sending ACK %d\n", frame_id, expected_frame);
            sendto(sockfd, &expected_frame, sizeof(expected_frame), 0, (struct sockaddr*)&client_addr, addr_len);
            expected_frame++;
        } else {
            printf("[Receiver] Out-of-order Frame %d ignored. Expecting Frame %d\n", frame_id, expected_frame);
        }
    }
    
    printf("\nAll frames received successfully.\n");
    close(sockfd);
    return 0;
}
