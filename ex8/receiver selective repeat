#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#define BUFFER_SIZE 1024
#define WINDOW_SIZE 4

int checksum(char *data) {
    int sum = 0;
    int i;
    for (i = 0; data[i] != '\0'; i++) {
        sum += (unsigned char)data[i];
    }
    return sum % 256;
}

int main(int argc, char *argv[]) {
    int sockfd;
    int port;
    struct sockaddr_in receiver, sender;
    socklen_t sender_len;
    char buffer[BUFFER_SIZE];
    char data[500];
    char response[100];
    int seq_no;
    int received_checksum;
    int expected_base;
    int received_in_window[8];
    int i;

    if (argc != 2) {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    for (i = 0; i < 8; i++) {
        received_in_window[i] = 0;
    }

    port = atoi(argv[1]);
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sockfd < 0) {
        perror("Socket creation failed");
        return 1;
    }

    sender_len = sizeof(sender);
    receiver.sin_family = AF_INET;
    receiver.sin_addr.s_addr = INADDR_ANY;
    receiver.sin_port = htons(port);

    if (bind(sockfd, (struct sockaddr *)&receiver, sizeof(receiver)) < 0) {
        perror("Bind failed");
        close(sockfd);
        return 1;
    }

    printf("\n====================================\n");
    printf("        SELECTIVE REPEAT ARQ\n");
    printf("              RECEIVER\n");
    printf("====================================\n");
    printf("Listening on Port : %d\n", port);
    printf("Sliding Window Size: %d\n", WINDOW_SIZE);
    printf("====================================\n\n");

    expected_base = 0; 

    while (1) {
        int bytes;
        int calculated_checksum;
        int in_window;
        int ack_no;

        memset(buffer, 0, sizeof(buffer));
        memset(data, 0, sizeof(data));

        bytes = recvfrom(sockfd, buffer, sizeof(buffer) - 1, 0, (struct sockaddr *)&sender, &sender_len);
        if (bytes < 0) continue;

        if (strcmp(buffer, "END") == 0) {
            printf("\n====================================\n");
            printf("Communication completed successfully.\n");
            printf("====================================\n");
            break;
        }

        if (sscanf(buffer, "%d:%499[^:]:%d", &seq_no, data, &received_checksum) != 3) continue;

        printf("\nReceived Frame Sequence: %d\n", seq_no);
        printf("Data Content Received  : %s\n", data);

        calculated_checksum = checksum(data);
        printf("Received Checksum      : %d\n", received_checksum);
        printf("Calculated Checksum    : %d\n", calculated_checksum);

        if (received_checksum != calculated_checksum) {
            printf("Result                 : DATA CORRUPTION DETECTED!\n");
            sprintf(response, "NAK:%d", seq_no);
            sendto(sockfd, response, strlen(response), 0, (struct sockaddr *)&sender, sender_len);
            printf("Sent                   : %s\n", response);
            continue;
        }

        printf("Result                 : Checksum matches perfectly.\n");

        in_window = 0;
        for (i = 0; i < WINDOW_SIZE; i++) {
            if (((expected_base + i) % 8) == seq_no) {
                in_window = 1;
                break;
            }
        }

        if (in_window) {
            if (!received_in_window[seq_no]) {
                received_in_window[seq_no] = 1;
                printf("Action                 : Frame %d accepted into window storage.\n", seq_no);
            } else {
                printf("Action                 : Duplicate Frame %d detected.\n", seq_no);
            }

            ack_no = (seq_no + 1) % 8;
            sprintf(response, "ACK:%d", ack_no);
            sendto(sockfd, response, strlen(response), 0, (struct sockaddr *)&sender, sender_len);
            printf("Sent                   : %s\n", response);

            while (received_in_window[expected_base]) {
                received_in_window[expected_base] = 0; 
                expected_base = (expected_base + 1) % 8;
            }
        } else {
            printf("Action                 : Frame %d out of window bounds. Discarding payload.\n", seq_no);
            ack_no = (seq_no + 1) % 8;
            sprintf(response, "ACK:%d", ack_no);
            sendto(sockfd, response, strlen(response), 0, (struct sockaddr *)&sender, sender_len);
            printf("Resent                 : %s\n", response);
        }
    }

    close(sockfd);
    return 0;
}
