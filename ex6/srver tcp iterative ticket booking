#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8083

struct Movie {
    int id;
    char title[20];
    char time[10];
    int seats;
    int price;
};

struct Ticket {
    int ticket_id;
    int movie_id;
    int seats_booked;
    int active;
};

struct Movie movies[2] = {
    {1, "SciFi-Movie", "14:00", 40, 200},
    {2, "Action-Movie", "18:00", 30, 250}
};

struct Ticket tickets[100];
int ticket_count = 0;
int next_ticket_id = 5001;

void handle_client(int client_sock) {
    int choice;
    while (recv(client_sock, &choice, sizeof(choice), 0) > 0) {
        if (choice == 1) {
            send(client_sock, movies, sizeof(movies), 0);
        }
        else if (choice == 2) {
            int movie_id, available_seats = -1;
            recv(client_sock, &movie_id, sizeof(movie_id), 0);
            for (int i = 0; i < 2; i++) {
                if (movies[i].id == movie_id) {
                    available_seats = movies[i].seats;
                    break;
                }
            }
            send(client_sock, &available_seats, sizeof(available_seats), 0);
        }
        else if (choice == 3) {
            int movie_id, seats_req, res_id = -1;
            recv(client_sock, &movie_id, sizeof(movie_id), 0);
            recv(client_sock, &seats_req, sizeof(seats_req), 0);
            for (int i = 0; i < 2; i++) {
                if (movies[i].id == movie_id && movies[i].seats >= seats_req && seats_req > 0) {
                    movies[i].seats -= seats_req;
                    res_id = next_ticket_id++;
                    tickets[ticket_count].ticket_id = res_id;
                    tickets[ticket_count].movie_id = movie_id;
                    tickets[ticket_count].seats_booked = seats_req;
                    tickets[ticket_count].active = 1;
                    ticket_count++;
                    break;
                }
            }
            send(client_sock, &res_id, sizeof(res_id), 0);
        }
        else if (choice == 4) {
            int t_id, success = 0;
            recv(client_sock, &t_id, sizeof(t_id), 0);
            for (int i = 0; i < ticket_count; i++) {
                if (tickets[i].ticket_id == t_id && tickets[i].active == 1) {
                    tickets[i].active = 0;
                    for (int j = 0; j < 2; j++) {
                        if (movies[j].id == tickets[i].movie_id) {
                            movies[j].seats += tickets[i].seats_booked;
                            break;
                        }
                    }
                    success = 1;
                    break;
                }
            }
            send(client_sock, &success, sizeof(success), 0);
        }
        else if (choice == 5) {
            int t_id;
            struct Ticket found_ticket = {-1, -1, -1, -1};
            recv(client_sock, &t_id, sizeof(t_id), 0);
            for (int i = 0; i < ticket_count; i++) {
                if (tickets[i].ticket_id == t_id) {
                    found_ticket = tickets[i];
                    break;
                }
            }
            send(client_sock, &found_ticket, sizeof(found_ticket), 0);
        }
        else if (choice == 6) {
            break;
        }
    }
    close(client_sock);
}

int main() {
    int server_sock, client_sock;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_size = sizeof(client_addr);

    server_sock = socket(AF_INET, SOCK_STREAM, 0);
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = INADDR_ANY;

    bind(server_sock, (struct sockaddr*)&server_addr, sizeof(server_addr));
    listen(server_sock, 5);

    printf("Iterative Movie Server listening on port %d...\n", PORT);

    while (1) {
        client_sock = accept(server_sock, (struct sockaddr*)&client_addr, &addr_size);
        handle_client(client_sock);
    }

    close(server_sock);
    return 0;
}
