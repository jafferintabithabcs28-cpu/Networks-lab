#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8081

struct Train {
    int id;
    char name[20];
    char route[30];
    int seats;
    int fare;
};

struct Booking {
    int pnr;
    int train_id;
    int seats_booked;
    int status;
};

int main() {
    int sock;
    struct sockaddr_in server_addr;
    int choice;

    sock = socket(AF_INET, SOCK_STREAM, 0);
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr("127.0.0.1");

    if (connect(sock, (struct sockaddr*)&server_addr, sizeof(server_addr)) < 0) {
        printf("Connection failed.\n");
        return 1;
    }

    while (1) {
        printf("\n--- Railway System Menu ---\n");
        printf("1. Search Trains\n");
        printf("2. Check Seat Availability\n");
        printf("3. Book Ticket\n");
        printf("4. Cancel Reservation\n");
        printf("5. View Booking Status\n");
        printf("6. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        send(sock, &choice, sizeof(choice), 0);

        if (choice == 1) {
            struct Train t[2];
            recv(sock, t, sizeof(t), 0);
            printf("\nTrain ID\tName\t\tRoute\t\tAvailable Seats\tFare\n");
            for (int i = 0; i < 2; i++) {
                printf("%d\t\t%s\t%s\t%d\t\t%d\n", t[i].id, t[i].name, t[i].route, t[i].seats, t[i].fare);
            }
        } 
        else if (choice == 2) {
            int train_id, seats;
            printf("Enter Train ID: ");
            scanf("%d", &train_id);
            send(sock, &train_id, sizeof(train_id), 0);
            recv(sock, &seats, sizeof(seats), 0);
            if (seats == -1) {
                printf("Invalid Train ID.\n");
            } else {
                printf("Available Seats: %d\n", seats);
            }
        } 
        else if (choice == 3) {
            int train_id, seats_req, pnr;
            printf("Enter Train ID: ");
            scanf("%d", &train_id);
            printf("Enter number of seats to book: ");
            scanf("%d", &seats_req);
            send(sock, &train_id, sizeof(train_id), 0);
            send(sock, &seats_req, sizeof(seats_req), 0);
            recv(sock, &pnr, sizeof(pnr), 0);
            if (pnr == -1) {
                printf("Booking failed! Insufficient seats or invalid ID.\n");
            } else {
                printf("Booking successful! Generated PNR: %d\n", pnr);
            }
        } 
        else if (choice == 4) {
            int pnr, success;
            printf("Enter PNR to cancel: ");
            scanf("%d", &pnr);
            send(sock, &pnr, sizeof(pnr), 0);
            recv(sock, &success, sizeof(success), 0);
            if (success == 1) {
                printf("Cancellation successful.\n");
            } else {
                printf("Cancellation failed. Invalid PNR or already cancelled.\n");
            }
        } 
        else if (choice == 5) {
            int pnr;
            struct Booking b;
            printf("Enter PNR to view status: ");
            scanf("%d", &pnr);
            send(sock, &pnr, sizeof(pnr), 0);
            recv(sock, &b, sizeof(b), 0);
            if (b.pnr == -1) {
                printf("PNR not found.\n");
            } else {
                printf("\nPNR: %d\nTrain ID: %d\nSeats Booked: %d\nStatus: %s\n", 
                       b.pnr, b.train_id, b.seats_booked, (b.status == 1) ? "CONFIRMED" : "CANCELLED");
            }
        } 
        else if (choice == 6) {
            printf("Exiting...\n");
            break;
        }
    }

    close(sock);
    return 0;
}
