#include <stdio.h>
#include <string.h>
void reverse(char *start, char *end) {
    while (start < end) {
        char temp = *start;
        *start = *end;
        *end = temp;
        start++;
        end--;
    }
}

char* reverseWords(char* s) {
    int len = strlen(s);
    reverse(s, s + len - 1);
    int i = 0, j = 0;
    while (i < len) {
        while (i < len && s[i] == ' ') i++; 
        if (i == len) break;
        
        j = i;
        while (j < len && s[j] != ' ') j++; 
        
        reverse(s + i, s + j - 1); 
        i = j;
    }
    
    int write_idx = 0;
    for (i = 0; i < len; i++) {
        if (s[i] != ' ') {
            if (write_idx > 0 && s[i - 1] == ' ') {
                s[write_idx++] = ' '; 
            }
            s[write_idx++] = s[i];
        }
    }
    s[write_idx] = '\0'; 
    
    return s;
}
