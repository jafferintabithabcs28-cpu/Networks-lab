#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <unistd.h>
#include <arpa/inet.h>
#define MAX_BITS 100000
#define MAX_POLY 100
#define MAX_DEGREE 50
void charToBinary(unsigned char ch, char binary[])
{
    int i;

    for (i = 7; i >= 0; i--)
    {
        binary[7 - i] = ((ch >> i) & 1) ? '1' : '0';
    }

    binary[8] = '\0';
}
void polynomialToBinary(char polynomial[], char binary[])
{
    int powers[MAX_DEGREE] = {0};
    int maxPower = 0;
    int i = 0;
    int power;
    while (polynomial[i] != '\0')
    {
        while (polynomial[i] == ' ' ||
               polynomial[i] == '+')
        {
            i++;
        }
        if (polynomial[i] == 'x' ||
            polynomial[i] == 'X')
        {
            i++;
            if (polynomial[i] == '^')
            {
                i++;
                power = 0;
                while (isdigit(polynomial[i]))
                {
                    power = power * 10 +
                            (polynomial[i] - '0');
                    i++;
                }
            }
            else
            {
                power = 1;
            }
            powers[power] = 1;
            if (power > maxPower)
            {
                maxPower = power;
            }
        }
        else if (polynomial[i] == '1')
        {
            powers[0] = 1;
            i++;
        }
        else
        {
            i++;
        }
    }
    for (i = maxPower; i >= 0; i--)
    {
        if (powers[i] == 1)
            binary[maxPower - i] = '1';
        else
            binary[maxPower - i] = '0';
    }
    binary[maxPower + 1] = '\0';
}
void generateCRC(char data[], char divisor[], char crc[])
{
    char temp[MAX_BITS];
    int dataLen;
    int divisorLen;
    int i, j;
    dataLen = strlen(data);
    divisorLen = strlen(divisor);
    strcpy(temp, data);
    for (i = 0; i < divisorLen - 1; i++)
    {
        temp[dataLen + i] = '0';
    }
    temp[dataLen + divisorLen - 1] = '\0';
    for (i = 0; i < dataLen; i++)
    {
        if (temp[i] == '1')
        {
            for (j = 0; j < divisorLen; j++)
            {
                if (temp[i + j] == divisor[j])
                    temp[i + j] = '0';
                else
                    temp[i + j] = '1';
            }
        }
    }
    for (i = 0; i < divisorLen - 1; i++)
    {
        crc[i] = temp[dataLen + i];
    }
    crc[divisorLen - 1] = '\0';
}
int main(int argc, char *argv[])
{
    int client_fd;
    int port;
    int ch;
    int frameLen;
    int polyLen;
    int bitPosition;
    char filename[100];
    char choice;
    char polynomial[MAX_POLY];
    char divisor[MAX_POLY];
    char data[MAX_BITS] = "";
    char binary[9];
    char crc[MAX_POLY];
    char frame[MAX_BITS];
    FILE *fp;
    struct sockaddr_in server_addr;
    if (argc != 3)
    {
        printf("Usage: %s <server_ip> <port>\n", argv[0]);
        exit(1);
    }
    port = atoi(argv[2]);
    printf("Enter input file name: ");
    scanf("%99s", filename);
    fp = fopen(filename, "r");
    if (fp == NULL)
    {
        printf("Cannot open input file.\n");
        exit(1);
    }
    while ((ch = fgetc(fp)) != EOF)
    {
        charToBinary((unsigned char)ch, binary);
        strcat(data, binary);
    }
    fclose(fp);
    printf("\nBinary Data from File:\n%s\n", data);
    printf("\nEnter generator polynomial:\n");
    printf("Example: x^3 + x + 1\n");
    printf("Polynomial: ");
    getchar();
    fgets(polynomial, MAX_POLY, stdin);
    polynomial[strcspn(polynomial, "\n")] = '\0';
    polynomialToBinary(polynomial, divisor);
    printf("\nPolynomial entered: %s\n", polynomial);
    printf("Binary divisor: %s\n", divisor);
    generateCRC(data, divisor, crc);
    printf("\nGenerated CRC: %s\n", crc);
    strcpy(frame, data);
    strcat(frame, crc);
    printf("\nFrame before error:\n%s\n", frame);
    printf("\nDo you want to change any bit? (Y/N): ");
    scanf(" %c", &choice);
    if (choice == 'Y' || choice == 'y')
    {
        printf("Enter bit position to change (1 to %ld): ",
               strlen(frame));
        scanf("%d", &bitPosition);
        if (bitPosition >= 1 &&
            bitPosition <= (int)strlen(frame))
        {
            bitPosition--;
            if (frame[bitPosition] == '0')
                frame[bitPosition] = '1';
            else
                frame[bitPosition] = '0';
            printf("Bit changed successfully.\n");
        }
        else
        {
            printf("Invalid bit position.\n");
        }
    }
    printf("\nFinal Frame Sent to Server:\n%s\n", frame);
    client_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (client_fd < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(port);
    if (inet_pton(AF_INET, argv[1],&server_addr.sin_addr) <= 0)
    {
        printf("Invalid IP address.\n");
        exit(1);
    }
    if (connect(client_fd,(struct sockaddr *)&server_addr,
                sizeof(server_addr)) < 0)
    {
        perror("Connection failed");
        exit(1);
    }
    printf("\nConnected to server.\n");
    polyLen = strlen(divisor);
    send(client_fd, &polyLen, sizeof(int), 0);
    send(client_fd, divisor, polyLen, 0);
    frameLen = strlen(frame);
    send(client_fd, &frameLen, sizeof(int), 0);
    send(client_fd, frame, frameLen, 0);
    printf("Frame sent successfully.\n");
    close(client_fd);
    return 0;
}
