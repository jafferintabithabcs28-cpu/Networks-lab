#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define BUFFER_SIZE 1024

void upload_file(int client_socket)
{
    char filename[100];
    char buffer[BUFFER_SIZE];
    FILE *fp;
    int n;

    printf("Enter filename to upload: ");
    scanf("%s", filename);

    send(client_socket,
         filename,
         strlen(filename) + 1,
         0);

    recv(client_socket, buffer, sizeof(buffer), 0);

    if (strcmp(buffer, "ERROR") == 0)
    {
        printf("Server cannot create the file\n");
        return;
    }

    fp = fopen(filename, "r");

    if (fp == NULL)
    {
        printf("File not found in client system\n");
        return;
    }

    while ((n = fread(buffer, 1, sizeof(buffer), fp)) > 0)
    {
        send(client_socket, buffer, n, 0);
    }

    send(client_socket, "EOF", 4, 0);

    fclose(fp);

    recv(client_socket, buffer, sizeof(buffer), 0);

    printf("%s\n", buffer);
}

void download_file(int client_socket)
{
    char filename[100];
    char buffer[BUFFER_SIZE];
    FILE *fp;
    int n;

    printf("Enter filename to download: ");
    scanf("%s", filename);

    send(client_socket,
         filename,
         strlen(filename) + 1,
         0);

    recv(client_socket, buffer, sizeof(buffer), 0);

    if (strcmp(buffer, "FILE_NOT_FOUND") == 0)
    {
        printf("File not found on server\n");
        return;
    }

    fp = fopen(filename, "w");

    while (1)
    {
        n = recv(client_socket, buffer, sizeof(buffer), 0);

        if (n <= 0)
            break;

        if (n == 4 && strncmp(buffer, "EOF", 3) == 0)
            break;

        fwrite(buffer, 1, n, fp);
    }

    fclose(fp);

    printf("File downloaded successfully\n");
}

int main(int argc, char *argv[])
{
    int client_socket;
    int port;

    struct sockaddr_in server_addr;

    char username[50];
    char password[50];
    char choice[20];
    char buffer[BUFFER_SIZE];

    if (argc != 3)
    {
        printf("Usage: %s <server_ip> <port>\n", argv[0]);
        return 1;
    }

    port = atoi(argv[2]);

    client_socket = socket(AF_INET, SOCK_STREAM, 0);

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(port);

    if (inet_pton(AF_INET,
                  argv[1],
                  &server_addr.sin_addr) <= 0)
    {
        printf("Invalid IP address\n");
        return 1;
    }

    if (connect(client_socket,
                (struct sockaddr *)&server_addr,
                sizeof(server_addr)) < 0)
    {
        perror("Connection failed");
        exit(EXIT_FAILURE);
    }

    printf("Connected to Server\n");

    printf("Enter Username: ");
    scanf("%s", username);

    printf("Enter Password: ");
    scanf("%s", password);

    send(client_socket, username, strlen(username) + 1, 0);
    send(client_socket, password, strlen(password) + 1, 0);

    recv(client_socket, buffer, sizeof(buffer), 0);

    if (strcmp(buffer, "AUTH_FAILED") == 0)
    {
        printf("Authentication Failed\n");

        close(client_socket);
        return 0;
    }

    printf("Authentication Successful\n");

    while (1)
    {
        printf("\n1. Upload File\n");
        printf("2. Download File\n");
        printf("3. Get Server Date and Time\n");
        printf("4. Get Server System Information\n");
        printf("5. Terminate Session\n");

        printf("Enter your choice: ");
        scanf("%s", choice);

        send(client_socket,
             choice,
             strlen(choice) + 1,
             0);

        if (strcmp(choice, "1") == 0)
        {
            upload_file(client_socket);
        }

        else if (strcmp(choice, "2") == 0)
        {
            download_file(client_socket);
        }

        else
        {
            recv(client_socket,
                 buffer,
                 sizeof(buffer),
                 0);

            printf("\n%s\n", buffer);

            if (strcmp(choice, "5") == 0)
                break;
        }
    }

    close(client_socket);

    return 0;
}
