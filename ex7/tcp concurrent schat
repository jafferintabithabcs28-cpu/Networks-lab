#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/select.h>
#include <errno.h>
#define BUFFER_SIZE 1024
typedef struct
{
    int fd;
    int client_no;
    struct sockaddr_in address;
} Client;
Client clients[FD_SETSIZE];
int client_count = 0;
int next_client_no = 1;
int find_client(int client_no)
{
    int i;
    for (i = 0; i < client_count; i++)
    {
        if (clients[i].client_no == client_no)
            return i;
    }
    return -1;
}
void remove_client(int index)
{
    close(clients[index].fd);
    clients[index] = clients[client_count - 1];
    client_count--;
}
void send_to_client(int index, char *message)
{
    if (send(clients[index].fd,message,strlen(message),0) < 0)
    {
        perror("send");
    }
}
int main(int argc, char *argv[])
{
    int server_fd;
    int client_fd;
    int port;
    int opt = 1;
    int max_fd;
    int activity;
    int i;
    int n;
    char buffer[BUFFER_SIZE];
    char message[BUFFER_SIZE + 100];
    fd_set readfds;
    struct sockaddr_in server_addr;
    struct sockaddr_in client_addr;
    socklen_t addr_len;
    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }
    port = atoi(argv[1]);
    printf("========================================\n");
    printf("       CONCURRENT TCP CHAT SERVER\n");
    printf("========================================\n");
    server_fd = socket(AF_INET,SOCK_STREAM,0);
    if (server_fd < 0)
    {
        perror("socket");
        return 1;
    }
    if (setsockopt(server_fd, SOL_SOCKET,SO_REUSEADD,&opt,sizeof(opt)) < 0)
    {
        perror("setsockopt");
        close(server_fd);
        return 1;
    }
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = htonl(INADDR_ANY);
    server_addr.sin_port = htons(port);
    if (bind(server_fd,(struct sockaddr *)&server_addr,sizeof(server_addr)) < 0)
    {
        perror("bind");
        close(server_fd);
        return 1;
    }
    if (listen(server_fd, SOMAXCONN) < 0)
    {
        perror("listen");
        close(server_fd);
        return 1;
    }
    printf("\nServer started successfully.\n");
    printf("Port: %d\n", port);
    printf("Waiting for clients...\n\n");
    while (1)
    {
        FD_ZERO(&readfds);
        FD_SET(server_fd, &readfds);
        max_fd = server_fd;
        for (i = 0; i < client_count; i++)
        {
            FD_SET(clients[i].fd, &readfds);
            if (clients[i].fd > max_fd)
                max_fd = clients[i].fd;
        }
        FD_SET(STDIN_FILENO, &readfds);
        if (STDIN_FILENO > max_fd)
            max_fd = STDIN_FILENO;
        activity = select(max_fd + 1,&readfds,NULL,NULL,NULL);
        if (activity < 0)
        {
            if (errno == EINTR)
                continue;
            perror("select");
            break;
        }
        if (FD_ISSET(server_fd, &readfds))
        {
            addr_len = sizeof(client_addr);
            client_fd = accept(server_fd,(struct sockaddr *)&client_addr,
                               &addr_len);
            if (client_fd < 0)
            {
                perror("accept");
            }
            else
            {
                if (client_fd >= FD_SETSIZE)
                {
                    printf("System socket limit reached.\n");
                    close(client_fd);
                }
                else
                {
                    clients[client_count].fd = client_fd;
                    clients[client_count].client_no =
                        next_client_no++;
                    clients[client_count].address =
                        client_addr;
                    printf("\nClient %d connected.\n",
                           clients[client_count].client_no);
                    printf("IP   : %s\n",
                           inet_ntoa(client_addr.sin_addr));
                    printf("Port : %d\n",
                           ntohs(client_addr.sin_port));
                    printf("Total connected clients: %d\n",
                           client_count + );
                    snprintf(message,
                             sizeof(message),
                             "You are Client %d. Connected to server.\n",
                             clients[client_count].client_no);
                    send(client_fd,message,strlen(message),0);
                    client_count++;
                }
            }
        }
        for (i = 0; i < client_count; i++)
        {
            int fd = clients[i].fd;
            if (FD_ISSET(fd, &readfds))
            {
                memset(buffer, 0, sizeof(buffer));
                n = recv(fd,buffer,sizeof(buffer) - 1,0);
                if (n <= 0)
                {
                    printf("\nClient %d disconnected.\n",
                           clients[i].client_no);
                    remove_client(i);
                    printf("Total connected clients: %d\n",
                           client_count);
                    i--;
                    continue;
                }
                buffer[n] = '\0';
                buffer[strcspn(buffer, "\n")] = '\0';
                printf("\n[Client %d] %s\n",clients[i].client_no,buffer);
                if (strcmp(buffer, "exit") == 0)
                {
                    printf("Client %d left the chat.\n",clients[i].client_no);
                    remove_client(i);
                    printf("Total connected clients: %d\n",client_count);
                    i--;
                    continue;
                }
            }
        }
        if (FD_ISSET(STDIN_FILENO, &readfds))
        {
            int target;
            int index;
            printf("\nEnter client number to send message: ");
            fflush(stdout);
            if (fgets(buffer,sizeof(buffer),stdin) == NULL)
            {
                continue;
            }
            buffer[strcspn(buffer, "\n")] = '\0';
            if (strcmp(buffer, "list") == 0)
            {
                printf("\n========== CONNECTED CLIENTS ==========\n");
                if (client_count == 0)
                {
                    printf("No clients connected.\n");
                }
                else
                {
                    for (i = 0; i < client_count; i++)
                    {
                        printf("Client %d -> %s:%d\n",clients[i].client_no,
                               inet_ntoa(clients[i].address.sin_addr),
                               ntohs(clients[i].address.sin_port));
                    }
                }
                printf("========================================\n");
                continue;
            }
            target = atoi(buffer);
            if (target <= 0)
            {
                printf("Invalid client number.\n");
                continue;
            }
            index = find_client(target);
            if (index == -1)
            {
                printf("Client %d is not connected.\n",target);
                continue;
          }
            printf("Server -> Client %d: ", target);
            fflush(stdout);
            if (fgets(message,sizeof(message),stdin) == NULL)
            {
                continue;
            }
            message[strcspn(message, "\n")] = '\0';
            send_to_client(index, message);
            printf("Message sent to Client %d.\n", target);
        }
    }
    for (i = 0; i < client_count; i++)
        close(clients[i].fd);
    close(server_fd);
    return 0;
}
