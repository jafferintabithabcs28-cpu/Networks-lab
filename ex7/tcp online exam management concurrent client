#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8091
#define MAX_Q 3

struct Question {
    char text[100];
    char options[4][50];
    int correct_opt;
};

int main() {
    int sock;
    struct sockaddr_in server_addr;
    char username[50];
    char password[50];
    int auth_status = 0;
    
    sock = socket(AF_INET, SOCK_STREAM, 0);
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr("127.0.0.1");
    
    if (connect(sock, (struct sockaddr*)&server_addr, sizeof(server_addr)) < 0) {
        printf("Connection failed.\n");
        return 1;
    }
    
    printf("--- Exam System Login ---\n");
    printf("Username: ");
    scanf("%s", username);
    printf("Password: ");
    scanf("%s", password);
    
    send(sock, username, sizeof(username), 0);
    send(sock, password, sizeof(password), 0);
    
    recv(sock, &auth_status, sizeof(auth_status), 0);
    
    if (!auth_status) {
        printf("Authentication failed. Invalid credentials.\n");
        close(sock);
        return 1;
    }
    
    printf("Login successful!\n");
    
    int choice;
    while (1) {
        printf("\n--- Dashboard Menu ---\n");
        printf("1. Retrieve Questions\n");
        printf("2. Submit Answers\n");
        printf("3. View Final Score\n");
        printf("4. Exit\n");
        printf("Enter option: ");
        scanf("%d", &choice);
        
        send(sock, &choice, sizeof(choice), 0);
        
        if (choice == 1) {
            struct Question q[MAX_Q];
            recv(sock, q, sizeof(q), 0);
            printf("\n--- Question Database ---\n");
            for (int i = 0; i < MAX_Q; i++) {
                printf("Q%d: %s\n", i + 1, q[i].text);
                for (int j = 0; j < 4; j++) {
                    printf("  %d. %s\n", j, q[i].options[j]);
                }
            }
        }
        else if (choice == 2) {
            int answers[MAX_Q];
            printf("\nEnter your answers (0-3 option indices):\n");
            for (int i = 0; i < MAX_Q; i++) {
                printf("Q%d Answer: ", i + 1);
                scanf("%d", &answers[i]);
            }
            send(sock, answers, sizeof(answers), 0);
            
            int instant_score;
            recv(sock, &instant_score, sizeof(instant_score), 0);
            printf("Answers evaluated. Score saved.\n");
        }
        else if (choice == 3) {
            int final_score;
            recv(sock, &final_score, sizeof(final_score), 0);
            if (final_score == -1) {
                printf("You have not taken the exam yet.\n");
            } else {
                printf("Your Final Score: %d / %d\n", final_score, MAX_Q);
            }
        }
        else if (choice == 4) {
            printf("Exiting dashboard.\n");
            break;
        }
    }
    
    close(sock);
    return 0;
}
