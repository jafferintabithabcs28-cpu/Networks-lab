#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/types.h>
#include <netinet/in.h>
#include <signal.h>

#define BUFFER_SIZE 1024

int main(int argc, char *argv[])
{
    int server_fd;
    int client_fd;
    int port;
    int opt = 1;
    char filename[256];
    char buffer[BUFFER_SIZE];
    FILE *fp;
    struct sockaddr_in server_addr;
    struct sockaddr_in client_addr;
    socklen_t len;
    pid_t pid;
    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }
    port = atoi(argv[1]);
    printf("========================================\n");
    printf("       CONCURRENT FILE SERVER\n");
    printf("========================================\n");
    printf("\nServer Port: %d\n", port);
    server_fd = socket(AF_INET, SOCK_STREAM,0);
    if (server_fd < 0)
    {
        perror("socket");
        return 1;
    }
    if (setsockopt(server_fd,
                   SOL_SOCKET,
                   SO_REUSEADDR,
                   &opt,
                   sizeof(opt)) < 0)
    {
        perror("setsockopt");
        close(server_fd);
        return 1;
    }
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = htonl(INADDR_ANY);
    server_addr.sin_port = htons(port);
    if (bind(server_fd,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0)
    {
        perror("bind");
        close(server_fd);
        return 1;
    }
    if (listen(server_fd, SOMAXCONN) < 0)
    {
        perror("listen");
        close(server_fd);
        return 1;
    }
    signal(SIGCHLD, SIG_IGN);
    printf("\nServer started successfully.\n");
    printf("Port: %d\n", port);
    printf("Waiting for clients...\n");
    while (1)
    {
        len = sizeof(client_addr);
        client_fd = accept(server_fd,
                           (struct sockaddr *)&client_addr,
                           &len);
        if (client_fd < 0)
        {
            perror("accept");
            continue;
        }
        printf("\nClient connected: %s:%d\n",
               inet_ntoa(client_addr.sin_addr),
               ntohs(client_addr.sin_port));
        pid = fork();
        if (pid < 0)
        {
            perror("fork");
            close(client_fd);
            continue;
        }
        if (pid == 0)
        {
            int n;
            close(server_fd);
            memset(filename, 0, sizeof(filename));
            n = recv(client_fd,
                     filename,
                     sizeof(filename) - 1,
                     0);
            if (n <= 0)
            {
                close(client_fd);
                exit(0);
            }
            filename[n] = '\0';
            printf("Child %d: Requested file = %s\n",
                   getpid(),
                   filename);
            fp = fopen(filename, "r");
            if (fp == NULL)
            {
                strcpy(buffer, "FILE_NOT_FOUND");
                send(client_fd,
                     buffer,
                     strlen(buffer),
                     0);
                printf("Child %d: File not found.\n",
                       getpid());
                close(client_fd);
                exit(0);
            }
            strcpy(buffer, "FILE_FOUND");
            send(client_fd,
                 buffer,
                 strlen(buffer),
                 0);
            while (fgets(buffer))
                         sizeof(buffer),
                         fp) != NULL)
            {
                send(client_fd,
                     buffer,
                     strlen(buffer),
                     0);
            }
            strcpy(buffer, "FILE_END");
            send(client_fd,buffer,strlen(buffer),
                 0);
            fclose(fp);
            printf("Child %d: File sent successfully.\n",
                   getpid());
            close(client_fd);
            exit(0);
        }
      else
        {
            close(client_fd);
        }
    }
    close(server_fd);
    return 0;
}
